<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Jellyfin.Plugin.PrivateSyncPlay.Api/Jellyfin.Plugin.PrivateSyncPlay.Api.csproj" GlobalPropertiesToRemove="Version" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" ExcludeAssets="runtime" />
    <EmbeddedResource Include="Web/*" />
    <EmbeddedResource Include="../../node_modules/hls.js/dist/hls.min.js" LogicalName="PrivateSyncPlay.hls.js" />
    <EmbeddedResource Include="../../node_modules/hls.js/LICENSE" LogicalName="PrivateSyncPlay.hls.LICENSE" />
  </ItemGroup>
</Project>
